{
  "name": "shadcn-3d-viewer",
  "version": "0.1.0",
  "description": "Source-owned shadcn 3D model viewer built with React Three Fiber",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michidk/shadcn-3d-viewer.git"
  },
  "homepage": "https://github.com/michidk/shadcn-3d-viewer#readme",
  "bugs": "https://github.com/michidk/shadcn-3d-viewer/issues",
  "keywords": ["shadcn", "3d", "viewer", "react-three-fiber", "gltf", "glb"],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "shadcn-3d-viewer": "bin/shadcn-3d-viewer.mjs"
  },
  "files": ["bin/", "public/r/model-viewer.json", "public/r/registry.json"],
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "playwright test",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0 --no-open --disable-telemetry",
    "storybook:build": "storybook build --disable-telemetry",
    "storybook:test": "playwright test --config playwright.storybook.config.ts",
    "registry:build": "shadcn build",
    "test:package": "node --test tests/package.test.mjs",
    "prepack": "bun run registry:build && bun run verify && bun run test:package",
    "verify": "bun run typecheck && bun run lint && bun run build"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.63.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "shadcn": "4.21.1",
    "storybook": "^10.6.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "three": "^0.180.0",
    "three-stdlib": "^2.36.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7"
  }
}
