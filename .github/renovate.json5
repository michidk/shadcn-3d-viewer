{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>michidk/workflows//templates/presets/renovate-library",
    ":enableVulnerabilityAlertsWithLabel('security')"
  ],
  "labels": [
    "no-stale",
    "bot"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "bun",
        "npm"
      ],
      "groupName": "All JavaScript Dependencies"
    }
  ]
}
